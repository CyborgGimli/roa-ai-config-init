{
  "description": "Shared MCP defaults for every ROA repository. Target repositories customize these through ai-config.yaml.",
  "servers": {
    "github": {
      "enabledByDefault": true,
      "required": [
        "tokenEnv"
      ],
      "config": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ]
      },
      "envFromConfig": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:tokenEnv}"
      }
    }
  }
}