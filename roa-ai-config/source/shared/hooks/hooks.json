{
  "description": "Shared ROA safety hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dangerous-command-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Checking shell command safety"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/maven-command-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Checking Maven command policy"
          }
        ]
      }
    ]
  }
}
