{
  "name": "roa-base",
  "displayName": "ROA Base",
  "version": "0.1.5",
  "description": "Bootstrap plugin providing setup and update machinery for ROA Claude Code plugins",
  "category": "framework",
  "tags": [
    "roa",
    "base",
    "framework",
    "install",
    "setup"
  ],
  "defaultEnabled": true,
  "dependencies": [],
  "copy": [
    {
      "from": "${plugin_dir}/README.md",
      "to": "README.md"
    },
    {
      "from": "${plugin_dir}/skills",
      "to": "skills"
    },
    {
      "from": "${plugin_dir}/agents",
      "to": "agents"
    },
    {
      "from": "${shared_dir}/hooks/scripts",
      "to": "hooks/scripts"
    },
    {
      "from": "${shared_dir}/scripts",
      "to": "scripts"
    },
    {
      "from": "${shared_dir}/lsp/lsp.json",
      "to": ".lsp.json"
    }
  ],
  "render": [
    {
      "from": "${shared_dir}/templates/plugin-basic.json",
      "to": ".claude-plugin/plugin.json"
    }
  ],
  "executable": [
    "skills/setup/scripts/setup.mjs",
    "skills/setup/scripts/install-prereqs.mjs",
    "hooks/scripts/dangerous-command-guard.mjs",
    "hooks/scripts/maven-command-guard.mjs",
    "hooks/scripts/generated-artifact-guard.mjs",
    "hooks/scripts/stop-validation-gate.mjs",
    "scripts/jdtls-launcher.mjs"
  ],
  "mergeHooks": [
    {
      "from": [
        "${shared_dir}/hooks/hooks.json"
      ],
      "to": "hooks/hooks.json",
      "description": "ROA shared hooks."
    }
  ]
}
