{
  "name": "roa-api",
  "displayName": "ROA API",
  "version": "0.1.5",
  "description": "ROA API test automation plugin with API architecture, contract investigation, implementation, validation, review, Pandora, AI Teacher, and Java engineering workflows.",
  "category": "test-automation",
  "tags": [
    "roa",
    "api",
    "java",
    "test-automation",
    "claude-code"
  ],
  "defaultEnabled": true,
  "dependencies": [
    "roa-base"
  ],
  "copy": [
    {
      "from": "${plugin_dir}/README.md",
      "to": "README.md"
    },
    {
      "from": "${shared_dir}/skills",
      "to": "skills"
    },
    {
      "from": "${plugin_dir}/skills",
      "to": "skills"
    },
    {
      "from": "${shared_dir}/agents",
      "to": "agents"
    },
    {
      "from": "${plugin_dir}/agents",
      "to": "agents"
    },
    {
      "from": "${shared_dir}/docs",
      "to": "docs"
    },
    {
      "from": "${plugin_dir}/docs",
      "to": "docs"
    },
    {
      "from": "${shared_dir}/output-styles",
      "to": "output-styles"
    },
    {
      "from": "${shared_dir}/themes",
      "to": "themes"
    }
  ],
  "render": [
    {
      "from": "${shared_dir}/templates/plugin-complete.json",
      "to": ".claude-plugin/plugin.json"
    }
  ],
  "setup": {
    "enabled": true,
    "enabledPlugin": "${plugin_name}@${marketplace_name}",
    "install": {
      "enabled": true,
      "scope": "project"
    },
    "ruleFile": ".claude/rules/${plugin_name}.md",
    "ruleTemplate": "generated/templates/${plugin_name}/rules.md",
    "claudeTemplate": "generated/templates/${plugin_name}/CLAUDE.md",
    "ruleTemplateSource": "${plugin_dir}/setup/rules.md",
    "claudeTemplateSource": "${plugin_dir}/setup/CLAUDE.md",
    "settingsFragments": [
      {
        "from": "${shared_dir}/settings/project-settings.json",
        "to": "generated/settings/shared/project-settings.json"
      },
      {
        "from": "${plugin_dir}/setup/settings.json",
        "to": "generated/settings/${plugin_name}/settings.json"
      }
    ],
    "aiConfigTemplate": {
      "from": "${shared_dir}/mcp/ai-config.example.yaml",
      "to": "generated/mcp/ai-config.example.yaml"
    },
    "mcpTemplates": [
      {
        "from": "${shared_dir}/mcp/project-shared.json",
        "to": "generated/mcp/shared/project-shared.json"
      },
      {
        "from": "${plugin_dir}/mcp/project-api.json",
        "to": "generated/mcp/${plugin_name}/project-mcp.json"
      }
    ],
    "rules": [
      {
        "from": "${shared_dir}/rules/roa-engineering.md",
        "to": "generated/rules/shared/roa-engineering.md",
        "target": ".claude/rules/roa-engineering.md",
        "marker": "shared/roa-engineering"
      },
      {
        "from": "${shared_dir}/rules/test-automation.md",
        "to": "generated/rules/shared/test-automation.md",
        "target": ".claude/rules/test-automation.md",
        "marker": "shared/test-automation"
      },
      {
        "from": "${shared_dir}/rules/validation.md",
        "to": "generated/rules/shared/validation.md",
        "target": ".claude/rules/validation.md",
        "marker": "shared/validation"
      },
      {
        "from": "${shared_dir}/rules/repository-safety.md",
        "to": "generated/rules/shared/repository-safety.md",
        "target": ".claude/rules/repository-safety.md",
        "marker": "shared/repository-safety"
      },
      {
        "from": "${plugin_dir}/setup/rules/api-architecture.md",
        "to": "generated/rules/${plugin_name}/api-architecture.md",
        "target": ".claude/rules/api-architecture.md",
        "marker": "${plugin_name}/api-architecture"
      },
      {
        "from": "${plugin_dir}/setup/rules/api-contracts.md",
        "to": "generated/rules/${plugin_name}/api-contracts.md",
        "target": ".claude/rules/api-contracts.md",
        "marker": "${plugin_name}/api-contracts"
      },
      {
        "from": "${plugin_dir}/setup/rules/api-modeling.md",
        "to": "generated/rules/${plugin_name}/api-modeling.md",
        "target": ".claude/rules/api-modeling.md",
        "marker": "${plugin_name}/api-modeling"
      },
      {
        "from": "${plugin_dir}/setup/rules/api-testing.md",
        "to": "generated/rules/${plugin_name}/api-testing.md",
        "target": ".claude/rules/api-testing.md",
        "marker": "${plugin_name}/api-testing"
      }
    ],
    "extraDirectories": [
      ".claude",
      ".claude/rules"
    ]
  }
}
