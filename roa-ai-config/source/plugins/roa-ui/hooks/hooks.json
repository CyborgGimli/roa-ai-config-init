{
  "description": "roa-ui Java/Maven hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-java-edit.mjs"],
            "timeout": 130,
            "statusMessage": "Compiling changed Java modules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-test-gate.mjs"],
            "timeout": 620,
            "statusMessage": "Running ROA tests"
          }
        ]
      }
    ]
  }
}
