{
  "plugins": {
    "roa-api": {
      "marketplaceName": "roa-ai",
      "marketplaceRepo": "CyborgGimli/roa-ai-config-init",
      "marketplaceRef": "v0.1.1",
      "enabledPlugin": "roa-api@roa-ai",
      "pluginVersion": "0.1.1",
      "install": {
        "enabled": true,
        "scope": "project"
      },
      "ruleFile": ".claude/rules/roa-api.md",
      "ruleTemplate": "generated/templates/roa-api/rules.md",
      "claudeTemplate": "generated/templates/roa-api/CLAUDE.md",
      "extraDirectories": [
        ".claude",
        ".claude/rules",
        "src/test/java",
        "src/test/resources"
      ],
      "settingsFragments": [
        "generated/settings/shared/project-settings.json",
        "generated/settings/roa-api/settings.json"
      ],
      "aiConfigTemplate": "generated/mcp/ai-config.example.yaml",
      "mcpTemplates": [
        "generated/mcp/shared/project-shared.json",
        "generated/mcp/roa-api/project-mcp.json"
      ],
      "rules": [
        {
          "to": "generated/rules/shared/ethics.md",
          "target": ".claude/rules/ethics.md",
          "marker": "shared/ethics"
        },
        {
          "to": "generated/rules/shared/engineering.md",
