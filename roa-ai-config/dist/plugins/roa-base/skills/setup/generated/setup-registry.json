        },
        {
          "to": "generated/rules/roa-api/testing.md",
          "target": ".claude/rules/testing.md",
          "marker": "roa-api/testing"
        }
      ],
      "templateValues": {
        "plugin_name": "roa-api",
        "plugin_display_name": "ROA API Testing",
