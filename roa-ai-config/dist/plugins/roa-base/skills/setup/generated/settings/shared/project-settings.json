{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(node:*)",
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(//**/id_rsa)",
      "Read(//**/id_rsa*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Read(//**/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.m2/settings-security.xml)",
      "Read(~/.m2/settings-security4.xml)",

      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(npm publish *)",
      "Bash(docker push *)",
      "Bash(gh release *)",

      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(npm publish *)",
      "PowerShell(docker push *)",
      "PowerShell(gh release *)"
    ]
  },
  "env": {
    "MAVEN_OPTS": "-Xmx1g"
  }
}
