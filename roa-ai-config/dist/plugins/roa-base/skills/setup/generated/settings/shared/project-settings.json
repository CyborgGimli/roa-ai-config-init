{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(node:*)",
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/id_rsa)",
      "Read(//**/*.pem)",
      "Read(//**/credentials.json)"
    ]
  },
  "env": {
    "MAVEN_OPTS": "-Xmx1g"
  }
}
