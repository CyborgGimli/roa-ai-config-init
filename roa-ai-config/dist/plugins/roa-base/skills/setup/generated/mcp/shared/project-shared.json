{
  "servers": {
    "postgresql": {
      "enabledByDefault": false,
      "instancePath": "databases",
      "serverNameTemplate": "postgresql-${name}",
      "required": ["name", "dsnEnv"],
      "config": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-postgres", "${env:dsnEnv}"]
      }
    },
    "playwright": {
      "enabledByDefault": false,
      "config": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest"]
      }
    },
    "github": {
      "enabledByDefault": false,
      "required": ["repositories"],
      "envFromConfig": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:tokenEnv}",
        "ROA_MCP_GITHUB_REPOSITORIES": "${repositories|csv}"
      },
      "config": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"]
      }
    }
  }
}
