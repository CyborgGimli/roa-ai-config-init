{
  "description": "ROA API Testing hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/check-doc-currency.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dangerous-command-guard.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Checking shell command safety"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/maven-command-guard.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Checking Maven command policy"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/generated-artifact-guard.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Checking generated-artifact policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-java-edit.mjs"
            ],
            "timeout": 130,
            "statusMessage": "Compiling changed Java modules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-test-gate.mjs"
            ],
            "timeout": 620,
            "statusMessage": "Running ROA tests"
          }
        ]
      }
    ]
  }
}
